<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/internal-nlog.txt">

  <extensions>
    <add assembly="NLog.Web.AspNetCore"/>
  </extensions>

  <variable name="logDirectory" value="${specialfolder:folder=LocalApplicationData}/LabSto/logs"/>

  <targets>
    <!-- 所有日志（含 Microsoft） -->
    <target xsi:type="File"
            name="allfile"
            fileName="${logDirectory}/nlog-all-${shortdate}.log"
            layout="${longdate}|${level}|${logger}|${message}${onexception:${newline}${exception:format=tostring}}"
            keepFileOpen="false"
            encoding="utf-8"/>

    <!-- 仅应用日志 -->
    <target xsi:type="File"
            name="ownFile-web"
            fileName="${logDirectory}/nlog-app-${shortdate}.log"
            layout="${longdate}|${level}|${logger}|${aspnet-user-identity}|${message}${onexception:${newline}${exception:format=tostring}}"
            keepFileOpen="false"
            encoding="utf-8"/>

    <!-- 控制台输出（开发时查看） -->
    <target xsi:type="Console"
            name="console"
            layout="${longdate}|${level}|${logger}|${message}${onexception:${newline}${exception:format=tostring}}"/>
  </targets>

  <rules>
    <!-- 所有日志写入 allfile -->
    <logger name="*" minlevel="Debug" writeTo="allfile"/>

    <!-- 屏蔽 Microsoft.* 高于 Info 的噪音日志 -->
    <logger name="Microsoft.*" maxlevel="Info" final="true"/>

    <!-- 屏蔽 System.Net.Http 噪音 -->
    <logger name="System.Net.Http.*" maxlevel="Info" final="true"/>

    <!-- 应用日志（不含 Microsoft.*）写入 ownFile-web -->
    <logger name="*" minlevel="Debug" writeTo="ownFile-web"/>

    <!-- Info 及以上输出到控制台 -->
    <logger name="*" minlevel="Info" writeTo="console"/>
  </rules>
</nlog>
