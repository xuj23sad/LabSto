<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LabSto 实验室试剂管理系统</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LabSto.styles.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <partial name="_NavSidebar" />
        <div class="main-content">
            <div class="top-bar">
                <div class="top-bar-left">
                    <span class="top-bar-title">
                        @{
                            var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
                            var pageTitle = ctrl switch
                            {
                                "Home" => "首页",
                                "Statistics" => "数据统计",
                                "Reagents" => "试剂管理",
                                "StockRecords" => "出入库记录",
                                "Cabinets" => "试剂柜管理",
                                "Account" => "账户",
                                _ => ctrl ?? ""
                            };
                        }
                        @pageTitle
                    </span>
                </div>
                <div class="top-bar-right">
                    <div class="user-menu">
                        <div class="user-avatar">@(User.Identity?.Name?.FirstOrDefault().ToString().ToUpper() ?? "U")</div>
                        <span class="small">@User.Identity?.Name</span>
                    </div>
                </div>
            </div>
            <div class="container-fluid p-4">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </div>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
