@model LabSto.Models.Entities.StockRecord

@{
    ViewData["Title"] = "记录详情";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 text-primary fw-bold">记录详情</h4>
    <a asp-action="Index" class="btn btn-secondary">返回列表</a>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm" style="border-radius: 12px;">
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tr>
                        <td class="text-muted small" style="width: 35%;">试剂名称</td>
                        <td class="fw-semibold">@Model.Reagent?.Name</td>
                    </tr>
                    <tr>
                        <td class="text-muted small">类型</td>
                        <td>
                            @if (Model.Type == "入库")
                            {
                                <span class="badge bg-success">入库</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">出库</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted small">数量</td>
                        <td class="fw-bold @(Model.Type == "入库" ? "text-success" : "text-danger") fs-5">
                            @(Model.Type == "入库" ? "+" : "-")@Model.Quantity @Model.Reagent?.Unit
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted small">操作人</td>
                        <td>@Model.OperatorName</td>
                    </tr>
                    <tr>
                        <td class="text-muted small">时间</td>
                        <td>@Model.CreateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    </tr>
                    @if (!string.IsNullOrEmpty(Model.Remark))
                    {
                        <tr>
                            <td class="text-muted small">备注</td>
                            <td>@Model.Remark</td>
                        </tr>
                    }
                </table>
                <hr />
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">编辑</a>
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('确定要删除此记录吗？库存将回滚。');">删除</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
