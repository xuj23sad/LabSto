@model IEnumerable<LabSto.Models.Entities.StockRecord>

@{
    ViewData["Title"] = "出入库记录";
    var totalCount = (int)(ViewData["TotalCount"] ?? 0);
    var pageNum = (int)(ViewData["PageNum"] ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 1);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0"><span class="text-primary fw-bold">出入库记录</span></h4>
        <small class="text-muted">共 @totalCount 条记录</small>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
        新增记录
    </a>
</div>

<div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-3">
                <input name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="搜索试剂名称/操作人" />
            </div>
            <div class="col-md-2">
                <select name="typeFilter" class="form-select">
                    <option value="">全部类型</option>
                    <option value="入库" selected="@((string)ViewData["TypeFilter"] == "入库")">入库</option>
                    <option value="出库" selected="@((string)ViewData["TypeFilter"] == "出库")">出库</option>
                </select>
            </div>
            <div class="col-md-2">
                <input type="date" name="startDate" value="@ViewData["StartDate"]" class="form-control" placeholder="开始日期" />
            </div>
            <div class="col-md-2">
                <input type="date" name="endDate" value="@ViewData["EndDate"]" class="form-control" placeholder="结束日期" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607z"/></svg>
                    筛选
                </button>
                <a asp-action="Index" class="btn btn-secondary">重置</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm" style="border-radius: 12px;">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>试剂名称</th>
                        <th>类型</th>
                        <th>数量</th>
                        <th>操作人</th>
                        <th>时间</th>
                        <th>备注</th>
                        <th class="text-end">操作</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">暂无记录</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold text-truncate" style="max-width:150px;" title="@item.Reagent?.Name">@item.Reagent?.Name</td>
                            <td>
                                @if (item.Type == "入库")
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success">入库</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger">出库</span>
                                }
                            </td>
                            <td class="fw-semibold @(item.Type == "入库" ? "text-success" : "text-danger")">
                                @(item.Type == "入库" ? "+" : "-")@item.Quantity
                            </td>
                            <td class="text-muted">@item.OperatorName</td>
                            <td class="text-muted">@item.CreateTime.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-muted text-truncate" style="max-width:120px;">@item.Remark</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">详情</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">编辑</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (totalPages > 1)
    {
        <div class="card-footer bg-white border-0 d-flex justify-content-center gap-2">
            @if (pageNum > 1)
            {
                <a asp-action="Index"
                   asp-route-page="1"
                   asp-route-searchString="@ViewData["CurrentFilter"]"
                   asp-route-typeFilter="@ViewData["TypeFilter"]"
                   asp-route-startDate="@ViewData["StartDate"]"
                   asp-route-endDate="@ViewData["EndDate"]"
                   class="btn btn-sm btn-outline-primary">首页</a>
                <a asp-action="Index"
                   asp-route-page="@(pageNum - 1)"
                   asp-route-searchString="@ViewData["CurrentFilter"]"
                   asp-route-typeFilter="@ViewData["TypeFilter"]"
                   asp-route-startDate="@ViewData["StartDate"]"
                   asp-route-endDate="@ViewData["EndDate"]"
                   class="btn btn-sm btn-outline-primary">上一页</a>
            }
            <span class="btn btn-sm btn-light">第 @pageNum / @totalPages 页</span>
            @if (pageNum < totalPages)
            {
                <a asp-action="Index"
                   asp-route-page="@(pageNum + 1)"
                   asp-route-searchString="@ViewData["CurrentFilter"]"
                   asp-route-typeFilter="@ViewData["TypeFilter"]"
                   asp-route-startDate="@ViewData["StartDate"]"
                   asp-route-endDate="@ViewData["EndDate"]"
                   class="btn btn-sm btn-outline-primary">下一页</a>
                <a asp-action="Index"
                   asp-route-page="@totalPages"
                   asp-route-searchString="@ViewData["CurrentFilter"]"
                   asp-route-typeFilter="@ViewData["TypeFilter"]"
                   asp-route-startDate="@ViewData["StartDate"]"
                   asp-route-endDate="@ViewData["EndDate"]"
                   class="btn btn-sm btn-outline-primary">末页</a>
            }
        </div>
    }
</div>
