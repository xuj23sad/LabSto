@model LabSto.Models.Entities.StockRecord

@{
    ViewData["Title"] = "新增记录";
}

<h4 class="mb-3">新增出入库记录</h4>
<hr />
<div class="row">
    <div class="col-md-5">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label class="form-label">试剂</label>
                <select asp-for="ReagentId" class="form-select" asp-items="ViewBag.ReagentId">
                    <option value="">-- 请选择试剂 --</option>
                </select>
                <span asp-validation-for="ReagentId" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">类型</label>
                <select asp-for="Type" class="form-select">
                    <option value="">-- 请选择 --</option>
                    <option value="入库">入库</option>
                    <option value="出库">出库</option>
                </select>
                <span asp-validation-for="Type" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">数量</label>
                <input asp-for="Quantity" class="form-control" placeholder="请输入数量" />
                <span asp-validation-for="Quantity" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">备注</label>
                <input asp-for="Remark" class="form-control" placeholder="可选" />
                <span asp-validation-for="Remark" class="text-danger small"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                    提交
                </button>
                <a asp-action="Index" class="btn btn-secondary">返回列表</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
