@model LabSto.Models.Entities.Cabinet

@{
    ViewData["Title"] = "管理格位";
    var slots = Model.Slots.OrderBy(s => s.SlotNo).ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0"><span class="text-primary fw-bold">格位管理</span></h4>
        <small class="text-muted">
            试剂柜：@Model.CabinetNo &nbsp;|&nbsp;
            位置：@Model.Location &nbsp;|&nbsp;
            存储类型：@Model.StorageType
        </small>
    </div>
    <div class="d-flex gap-2">
        @if (!slots.Any())
        {
            <form asp-action="InitializeSlots" asp-route-cabinetId="@Model.Id" method="post">
                <button type="submit" class="btn btn-success">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 3h6m-6 0a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2m-6 0h6"/></svg>
                    初始化格位
                </button>
            </form>
        }
        <a asp-controller="Cabinets" asp-action="Index" class="btn btn-secondary">返回试剂柜</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!slots.Any())
{
    <div class="alert alert-info">
        <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="me-2"><path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/><path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533L8.93 6.588zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"/></svg>
        此试剂柜尚未初始化格位。点击「初始化格位」按钮为该柜创建 @Model.Capacity 个存放格位。
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var slot in slots)
        {
            <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                @if (slot.Status == "占用" && slot.Reagent != null)
                {
                    <div class="card border-danger shadow-sm h-100" style="border-radius:12px; border-width:2px;">
                        <div class="card-body text-center p-3">
                            <div class="small text-muted mb-1">格位 @slot.SlotNo</div>
                            <div class="fw-bold text-danger mb-1" style="font-size:0.8rem;">@slot.Reagent.Name</div>
                            <div class="small text-muted mb-2">@slot.Reagent.Stock @slot.Reagent.Unit</div>
                            <form asp-action="AssignReagent" asp-route-slotId="@slot.Id" method="post">
                                <input type="hidden" name="reagentId" value="" />
                                <button type="submit" class="btn btn-sm btn-outline-danger w-100">移除</button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card border-success bg-light shadow-sm h-100" style="border-radius:12px; border-style:dashed;">
                        <div class="card-body text-center p-3">
                            <div class="small text-muted mb-2">格位 @slot.SlotNo</div>
                            <div class="text-success mb-2">
                                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
                            </div>
                            <div class="small text-muted mb-2">空置</div>
                            <form asp-action="AssignReagent" asp-route-slotId="@slot.Id" method="post" class="assign-form">
                                <select name="reagentId" class="form-select form-select-sm mb-1" asp-items="@(new SelectList(ViewBag.Reagents as IEnumerable<LabSto.Models.Entities.Reagent>, "Id", "Name"))">
                                    <option value="">选择试剂</option>
                                </select>
                                <button type="submit" class="btn btn-sm btn-success w-100">放置</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

<style>
    .assign-form select { font-size: 0.75rem; }
</style>
