@using Microsoft.EntityFrameworkCore
@inject LabSto.Data.LabStoContext context
@{
    ViewData["Title"] = "首页";
    var totalReagents = await context.Reagent.CountAsync();
    var lowStockCount = await context.Reagent.CountAsync(r => r.MinStock > 0 && r.Stock <= r.MinStock);
    var totalCabinets = await context.Cabinet.CountAsync();
    var today = DateTime.Today;
    var monthStart = new DateTime(today.Year, today.Month, 1);
    var todayRecords = await context.StockRecord.CountAsync(r => r.CreateTime.Date == today);
    var monthRecords = await context.StockRecord.CountAsync(r => r.CreateTime >= monthStart);
    var recentRecords = await context.StockRecord
        .Include(r => r.Reagent)
        .OrderByDescending(r => r.CreateTime)
        .Take(6)
        .ToListAsync();
    var recentReagents = await context.Reagent
        .OrderByDescending(r => r.CreateTime)
        .Take(5)
        .ToListAsync();
}

<div class="mb-4">
    <h5 class="mb-1">欢迎回来，@User.Identity?.Name</h5>
    <small class="text-muted">这里是实验室试剂管理的概况总览</small>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100" style="border-radius:12px; border-left: 4px solid #0d6efd !important;">
            <div class="card-body py-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-2" style="background:#e7f1ff;">
                        <svg width="24" height="24" fill="#0d6efd" viewBox="0 0 16 16"><path d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1zm0 1a6 6 0 1 1 0 12A6 6 0 0 1 8 2zm0 1a5 5 0 1 0 0 10A5 5 0 0 0 8 3z"/></svg>
                    </div>
                    <div>
                        <div class="text-muted small">试剂种类</div>
                        <div class="fw-bold fs-4" style="color:#0d6efd;">@totalReagents</div>
                        <div class="small text-muted">种</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100" style="border-radius:12px; border-left: 4px solid #198754 !important;">
            <div class="card-body py-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-2" style="background:#e8f5e9;">
                        <svg width="24" height="24" fill="#198754" viewBox="0 0 16 16"><path d="M2 1.5A1.5 1.5 0 0 1 3.5 0h9A1.5 1.5 0 0 1 14 1.5v1a.5.5 0 0 1-1 0V1.5h-10A1.5 1.5 0 0 1 1.5 0v1A.5.5 0 0 1 1 1.5V1.5zM1 3v10a1.5 1.5 0 0 0 1.5 1.5h11A1.5 1.5 0 0 0 14.5 13V3H1z"/></svg>
                    </div>
                    <div>
                        <div class="text-muted small">试剂柜</div>
                        <div class="fw-bold fs-4" style="color:#198754;">@totalCabinets</div>
                        <div class="small text-muted">个</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100" style="border-radius:12px; border-left: 4px solid #6610f2 !important;">
            <div class="card-body py-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-2" style="background:#f3e8ff;">
                        <svg width="24" height="24" fill="#6610f2" viewBox="0 0 16 16"><path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/></svg>
                    </div>
                    <div>
                        <div class="text-muted small">本月记录</div>
                        <div class="fw-bold fs-4" style="color:#6610f2;">@monthRecords</div>
                        <div class="small text-muted">条</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100 @(lowStockCount > 0 ? "border-warning" : "")" style="border-radius:12px; border-left: 4px solid #ffc107 !important;">
            <div class="card-body py-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-2" style="background:#fff8e1;">
                        <svg width="24" height="24" fill="#ffc107" viewBox="0 0 16 16"><path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/></svg>
                    </div>
                    <div>
                        <div class="text-muted small">库存预警</div>
                        <div class="fw-bold fs-4 @(lowStockCount > 0 ? "text-warning" : "text-success")">@lowStockCount</div>
                        <div class="small text-muted">种试剂</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm" style="border-radius: 12px;">
            <div class="card-header bg-white border-0 pb-0">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="small text-muted fw-semibold text-uppercase" style="letter-spacing:1px;">最近操作记录</span>
                    <a asp-controller="StockRecords" asp-action="Index" class="btn btn-sm btn-outline-primary">查看全部</a>
                </div>
            </div>
            <div class="card-body pt-2">
                @if (recentRecords.Any())
                {
                    <table class="table table-hover table-sm small mb-0">
                        <thead>
                            <tr class="text-muted">
                                <th>试剂</th>
                                <th>类型</th>
                                <th>数量</th>
                                <th>时间</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in recentRecords)
                            {
                                <tr>
                                    <td class="fw-semibold text-truncate" style="max-width:100px;">@r.Reagent?.Name</td>
                                    <td>
                                        @if (r.Type == "入库")
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success">入库</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger">出库</span>
                                        }
                                    </td>
                                    <td class="fw-semibold @(r.Type == "入库" ? "text-success" : "text-danger")">@(r.Type == "入库" ? "+" : "-")@r.Quantity</td>
                                    <td class="text-muted">@r.CreateTime.ToString("MM-dd HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-center text-muted py-4 small">暂无操作记录</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm" style="border-radius: 12px;">
            <div class="card-header bg-white border-0 pb-0">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="small text-muted fw-semibold text-uppercase" style="letter-spacing:1px;">快捷入口</span>
                </div>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-controller="Reagents" asp-action="Create" class="btn btn-outline-primary text-start">
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" class="me-2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
                        新增试剂
                    </a>
                    <a asp-controller="StockRecords" asp-action="Create" class="btn btn-outline-success text-start">
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" class="me-2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25"/></svg>
                        添加入库记录
                    </a>
                    <a asp-controller="StockRecords" asp-action="Create" class="btn btn-outline-danger text-start">
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" class="me-2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15"/></svg>
                        添加出库记录
                    </a>
                    <a asp-controller="Cabinets" asp-action="Create" class="btn btn-outline-secondary text-start">
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" class="me-2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21"/></svg>
                        新增试剂柜
                    </a>
                    <a asp-controller="Statistics" asp-action="Index" class="btn btn-outline-info text-start">
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" class="me-2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75z"/></svg>
                        查看数据统计
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
