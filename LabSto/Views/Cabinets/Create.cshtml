@model LabSto.Models.Entities.Cabinet

@{
    ViewData["Title"] = "新增试剂柜";
}

<h4 class="mb-3">新增试剂柜</h4>
<hr />
<div class="row">
    <div class="col-lg-5">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label class="form-label">柜编号 *</label>
                <input asp-for="CabinetNo" class="form-control" placeholder="如：A-01、B-02" />
                <span asp-validation-for="CabinetNo" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">存放位置 *</label>
                <input asp-for="Location" class="form-control" placeholder="如：实验室北侧墙、102房间" />
                <span asp-validation-for="Location" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">总格位数 *</label>
                <input asp-for="Capacity" class="form-control" type="number" min="1" placeholder="格位数量" />
                <span asp-validation-for="Capacity" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">存储类型 *</label>
                <select asp-for="StorageType" class="form-select">
                    <option value="常温">常温</option>
                    <option value="低温">低温（冷藏/冷冻）</option>
                    <option value="防火">防火安全柜</option>
                    <option value="避光">避光存储</option>
                    <option value="干燥">干燥环境</option>
                </select>
                <span asp-validation-for="StorageType" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">状态</label>
                <select asp-for="Status" class="form-select">
                    <option value="正常">正常</option>
                    <option value="维修中">维修中</option>
                    <option value="停用">停用</option>
                </select>
                <span asp-validation-for="Status" class="text-danger small"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                    保存
                </button>
                <a asp-action="Index" class="btn btn-secondary">返回列表</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
