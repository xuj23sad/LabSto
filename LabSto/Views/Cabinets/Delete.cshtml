@model LabSto.Models.Entities.Cabinet

@{
    ViewData["Title"] = "删除试剂柜";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 text-danger fw-bold">删除试剂柜</h4>
    <a asp-action="Index" class="btn btn-secondary btn-sm">返回</a>
</div>

<div class="alert alert-danger">
    <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="me-2"><path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/></svg>
    确定要删除试剂柜 <strong>@Model.CabinetNo</strong> 吗？此操作不可恢复。
</div>

<div class="card border-0 shadow-sm" style="border-radius:12px;">
    <div class="card-body">
        <table class="table table-borderless mb-0 small">
            <tr><td class="text-muted" style="width:40%;">柜编号</td><td>@Model.CabinetNo</td></tr>
            <tr><td class="text-muted">存放位置</td><td>@Model.Location</td></tr>
            <tr><td class="text-muted">总格位数</td><td>@Model.Capacity</td></tr>
            <tr><td class="text-muted">存储类型</td><td>@Model.StorageType</td></tr>
            <tr><td class="text-muted">状态</td><td>@Model.Status</td></tr>
        </table>
    </div>
</div>

<form asp-action="Delete" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/></svg>
        确认删除
    </button>
</form>
