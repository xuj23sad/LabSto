@model LabSto.Models.ViewModels.RegisterVM
@{
    ViewData["Title"] = "注册";
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>注册 - LabSto 实验室试剂管理系统</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 50%, #084298 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
        }
        .register-card {
            background: white;
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            overflow: hidden;
        }
        .register-left {
            background: linear-gradient(135deg, #198754, #157347);
            color: white;
            padding: 3rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            min-height: 500px;
        }
        .register-left h2 {
            font-weight: 700;
            font-size: 1.8rem;
        }
        .register-left p {
            opacity: 0.85;
            font-size: 0.95rem;
            line-height: 1.7;
        }
        .register-right {
            padding: 3rem;
        }
        .register-right h1 {
            font-size: 1.6rem;
            font-weight: 700;
            color: #212529;
            margin-bottom: 0.5rem;
        }
        .register-right .subtitle {
            color: #6c757d;
            font-size: 0.9rem;
            margin-bottom: 2rem;
        }
        .form-control:focus {
            border-color: #198754;
            box-shadow: 0 0 0 0.2rem rgba(25, 135, 84, 0.15);
        }
        .btn-register {
            background: #198754;
            border: none;
            font-weight: 600;
            padding: 0.6rem;
            font-size: 1rem;
        }
        .btn-register:hover {
            background: #157347;
        }
        .form-floating > label {
            color: #6c757d;
        }
        .system-title {
            font-size: 1.1rem;
            font-weight: 600;
            letter-spacing: 2px;
            opacity: 0.9;
        }
        .form-hint {
            font-size: 0.8rem;
            color: #6c757d;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-9">
                <div class="register-card row no-gutters">
                    <div class="col-lg-5 register-left">
                        <div class="system-title mb-4">LabSto</div>
                        <h2 class="mb-3">加入我们</h2>
                        <p class="mb-4">创建账户，开始高效管理实验室试剂。</p>
                        <div class="mt-4 pt-3" style="border-top: 1px solid rgba(255,255,255,0.2);">
                            <small style="opacity: 0.6; font-size: 0.75rem;">注册即表示您同意我们的<br />服务条款和隐私政策</small>
                        </div>
                    </div>
                    <div class="col-lg-7 register-right">
                        <h1>创建账户</h1>
                        <p class="subtitle">填写以下信息完成注册</p>
                        <form asp-action="Register" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                            <div class="form-floating mb-3">
                                <input asp-for="UserName" class="form-control" id="floatingUserName" placeholder="用户名" />
                                <label for="floatingUserName">用户名</label>
                                <span asp-validation-for="UserName" class="text-danger small"></span>
                            </div>
                            <div class="form-floating mb-3">
                                <input asp-for="Email" class="form-control" id="floatingEmail" placeholder="邮箱" />
                                <label for="floatingEmail">邮箱</label>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="form-floating mb-3">
                                <input asp-for="Password" type="password" class="form-control" id="floatingPassword" placeholder="密码" />
                                <label for="floatingPassword">密码</label>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                                <div class="form-hint mt-1">至少6位字符</div>
                            </div>
                            <div class="form-floating mb-4">
                                <input asp-for="ConfirmPassword" type="password" class="form-control" id="floatingConfirmPassword" placeholder="确认密码" />
                                <label for="floatingConfirmPassword">确认密码</label>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                            <button type="submit" class="btn btn-success w-100 btn-register">注 册</button>
                        </form>
                        <div class="text-center mt-4">
                            <span class="text-muted">已有账户？</span>
                            <a asp-action="Login" class="text-decoration-none fw-semibold">立即登录</a>
                        </div>
                    </div>
                </div>
                <div class="text-center text-white mt-3" style="opacity: 0.6; font-size: 0.8rem;">
                    &copy; 2026 LabSto 实验室试剂管理系统
                </div>
            </div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @section Scripts {
        @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    }
</body>
</html>
